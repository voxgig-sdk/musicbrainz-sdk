# Entity: tag

main: kit: entity: tag: {

  alias: field: {}

  name: "tag"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/tag"
          parts: [
            "tag"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "xml"
                kind: "query"
