      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

  entity: genre: {
    path: "/genre/all": {
      action: "all": {}
      op: list: method: *GET
    }
    path: "/genre/{mbid}": {
      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

  entity: instrument: {
    path: "/instrument": {
      op: list: method: *GET
    }
    path: "/instrument/{mbid}": {
