# Guide

guide: {
  metrics: count: entity: 19
  metrics: count: path: 32
  metrics: count: method: 34

  entity: area: {
    path: "/area": {
      op: list: method: *GET
    }
    path: "/area/{mbid}": {
      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

  entity: artist: {
    path: "/artist": {
      op: list: method: *GET
    }
    path: "/artist/{mbid}": {
      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

