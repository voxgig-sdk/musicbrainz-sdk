      op: list: method: *GET
    }
    path: "/place/{mbid}": {
      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

  entity: rating: {
    path: "/rating": {
      op: create: method: *POST
      op: load: method: *GET
    }
  }

  entity: recording: {
    path: "/recording": {
      op: list: method: *GET
    }
    path: "/recording/{mbid}": {
      rename: param: "mbid": *"id"
      op: load: method: *GET
    }
  }

  entity: recording_list: {
